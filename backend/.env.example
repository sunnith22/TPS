# Toyota Industries Engine India (TIEI)
# Employee Details API Backend Configuration

# 1. External Employee API Endpoint (Postman URL)
# Replace with your actual HRMS / ERP API endpoint:
TIEI_EMP_API_URL=https://hrms.internal.tiei.toyota-industries.com/api/employees

# 2. Authentication (Leave blank if no auth required on internal plant network)
TIEI_EMP_API_KEY=

# 3. Automatic Synchronization
# Syncs employee database automatically when backend starts up
AUTO_SYNC_ON_STARTUP=true

# Periodic background refresh interval in hours (e.g. 4 hours, 0 to disable)
BACKGROUND_SYNC_INTERVAL_HOURS=4

# Real-time login lookup: auto-fetch unknown employee IDs from API on login
DYNAMIC_LOGIN_SYNC=true
