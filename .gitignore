# Root ignore - ignore raw source documents, spreadsheets, and archives
*.xlsx
*.xls
*.pdf
*.zip
*.docx
*.doc
*.pptx
*.ppt
*.csv
001_*
Claude-*
claude_chat*
*.sql
scratch/

# Allow specific code project folders
!/backend/
!/backend/**
!/frontend/
!/frontend/**
!/backend/tps_database.db
!/.gitignore
!/README.md
!/run.py
!/run.bat

# Ignore build artifacts and dependencies
node_modules/
**/node_modules/
dist/
**/dist/
build/
**/build/
.env
**/.env
.DS_Store
Thumbs.db
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
__pycache__/
*.pyc
pgdata/
